// Npp Markdown Lite - GPL-3.0-or-later
#include "MarkdownLite/MenuIds.h"
IDR_M30_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建", IDM_FILE_NEW
        MENUITEM "新建 Markdown", IDM_MD_NEW
        MENUITEM "打开…", IDM_FILE_OPEN
        MENUITEM "重新载入", IDM_FILE_RELOAD
        MENUITEM SEPARATOR
        MENUITEM "保存", IDM_FILE_SAVE
        MENUITEM "另存为…", IDM_FILE_SAVEAS
        MENUITEM "全部保存", IDM_FILE_SAVEALL
        MENUITEM "重命名…", IDM_FILE_RENAME
        MENUITEM SEPARATOR
        MENUITEM "关闭", IDM_FILE_CLOSE
        MENUITEM "全部关闭", IDM_FILE_CLOSEALL
        MENUITEM "关闭其他", IDM_FILE_CLOSEALL_BUT_CURRENT
        MENUITEM SEPARATOR
        MENUITEM "退出", IDM_FILE_EXIT
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "撤销", IDM_EDIT_UNDO
        MENUITEM "重做", IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "剪切", IDM_EDIT_CUT
        MENUITEM "复制", IDM_EDIT_COPY
        MENUITEM "粘贴", IDM_EDIT_PASTE
        MENUITEM "删除", IDM_EDIT_DELETE
        MENUITEM "全选", IDM_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "复制当前行", IDM_EDIT_DUP_LINE
        MENUITEM "上移当前行", IDM_EDIT_LINE_UP
        MENUITEM "下移当前行", IDM_EDIT_LINE_DOWN
        MENUITEM "缩进", IDM_EDIT_INS_TAB
        MENUITEM "取消缩进", IDM_EDIT_RMV_TAB
        POPUP "换行格式"
        BEGIN
            MENUITEM "Windows (CR LF)", IDM_FORMAT_TODOS
            MENUITEM "Unix (LF)", IDM_FORMAT_TOUNIX
            MENUITEM "Macintosh (CR)", IDM_FORMAT_TOMAC
        END
        MENUITEM "列编辑…", IDM_EDIT_COLUMNMODE
        MENUITEM "只读", IDM_EDIT_TOGGLEREADONLY
        MENUITEM "复制完整路径", IDM_EDIT_FULLPATHTOCLIP
    END
    POPUP "搜索(&S)"
    BEGIN
        MENUITEM "查找…", IDM_SEARCH_FIND
        MENUITEM "替换…", IDM_SEARCH_REPLACE
        MENUITEM "文件中查找…", IDM_SEARCH_FINDINFILES
        MENUITEM "查找下一个", IDM_SEARCH_FINDNEXT
        MENUITEM "查找上一个", IDM_SEARCH_FINDPREV
        MENUITEM "增量查找", IDM_SEARCH_FINDINCREMENT
        MENUITEM "跳转行…", IDM_SEARCH_GOTOLINE
        MENUITEM SEPARATOR
        POPUP "书签"
        BEGIN
            MENUITEM "切换书签", IDM_SEARCH_TOGGLE_BOOKMARK
            MENUITEM "下一个书签", IDM_SEARCH_NEXT_BOOKMARK
            MENUITEM "上一个书签", IDM_SEARCH_PREV_BOOKMARK
            MENUITEM "清除书签", IDM_SEARCH_CLEAR_BOOKMARKS
        END
        MENUITEM "搜索结果", IDM_FOCUS_ON_FOUND_RESULTS
        MENUITEM "下一个结果", IDM_SEARCH_GOTONEXTFOUND
        MENUITEM "上一个结果", IDM_SEARCH_GOTOPREVFOUND
    END
    POPUP "视图(&V)"
    BEGIN
        MENUITEM "自动换行", IDM_VIEW_WRAP
        MENUITEM "显示空白符", IDM_VIEW_ALL_CHARACTERS
        MENUITEM SEPARATOR
        MENUITEM "放大", IDM_VIEW_ZOOMIN
        MENUITEM "缩小", IDM_VIEW_ZOOMOUT
        MENUITEM "恢复缩放", IDM_VIEW_ZOOMRESTORE
        MENUITEM SEPARATOR
        MENUITEM "移动到另一视图", IDM_VIEW_GOTO_ANOTHER_VIEW
        MENUITEM "克隆到另一视图", IDM_VIEW_CLONE_TO_ANOTHER_VIEW
        MENUITEM SEPARATOR
        MENUITEM "折叠全部", IDM_VIEW_FOLDALL
        MENUITEM "展开全部", IDM_VIEW_UNFOLDALL
        MENUITEM SEPARATOR
        MENUITEM "全屏", IDM_VIEW_FULLSCREENTOGGLE
        MENUITEM "专注模式", IDM_VIEW_DISTRACTIONFREE
        MENUITEM "置顶", IDM_VIEW_ALWAYSONTOP
    END
    POPUP "编码(&C)"
    BEGIN
        MENUITEM "ANSI", IDM_FORMAT_ANSI
        MENUITEM "UTF-8", IDM_FORMAT_AS_UTF_8
        MENUITEM "UTF-8 BOM", IDM_FORMAT_UTF_8
        MENUITEM "UTF-16 LE", IDM_FORMAT_UTF_16LE
        MENUITEM "UTF-16 BE", IDM_FORMAT_UTF_16BE
        MENUITEM SEPARATOR
        MENUITEM "转换为 UTF-8", IDM_FORMAT_CONV2_AS_UTF_8
        MENUITEM "转换为 UTF-8 BOM", IDM_FORMAT_CONV2_UTF_8
    END
    POPUP "语言(&L)"
    BEGIN
        MENUITEM "普通文本", IDM_LANG_TEXT
        MENUITEM "Markdown 模式", IDM_MD_MODE
        MENUITEM SEPARATOR
        MENUITEM "C / C++", IDM_LANG_CPP
        MENUITEM "CSS", IDM_LANG_CSS
        MENUITEM "HTML", IDM_LANG_HTML
        MENUITEM "JavaScript", IDM_LANG_JS
        MENUITEM "JSON", IDM_LANG_JSON
        MENUITEM "Python", IDM_LANG_PYTHON
        MENUITEM "PowerShell", IDM_LANG_POWERSHELL
        MENUITEM "Shell", IDM_LANG_BASH
        MENUITEM "SQL", IDM_LANG_SQL
        MENUITEM "XML", IDM_LANG_XML
        MENUITEM "YAML", IDM_LANG_YAML
        MENUITEM SEPARATOR
        MENUITEM "自定义语言…", IDM_LANG_USER_DLG
        MENUITEM "User-Defined", IDM_LANG_USER
    END
    POPUP "设置(&T)"
    BEGIN
        MENUITEM "首选项…", IDM_SETTING_PREFERENCE
        MENUITEM "样式…", IDM_LANGSTYLE_CONFIG_DLG
        MENUITEM "快捷键…", IDM_SETTING_SHORTCUT_MAPPER
        MENUITEM SEPARATOR
        MENUITEM "导入插件…", IDM_SETTING_IMPORTPLUGIN
        MENUITEM "导入主题…", IDM_SETTING_IMPORTSTYLETHEMES
    END
    POPUP "Markdown(&M)"
    BEGIN
        MENUITEM "增强排版", IDM_MD_RICH
        MENUITEM SEPARATOR
        MENUITEM "粗体", IDM_MD_BOLD
        MENUITEM "斜体", IDM_MD_ITALIC
        MENUITEM "行内代码", IDM_MD_CODE
        MENUITEM "链接", IDM_MD_LINK
        MENUITEM "代码块", IDM_MD_FENCE
        MENUITEM "切换任务", IDM_MD_TASK
        MENUITEM "对齐当前表格", IDM_MD_TABLE
        MENUITEM SEPARATOR
        MENUITEM "上一个标题", IDM_MD_PREV
        MENUITEM "下一个标题", IDM_MD_NEXT
    END
    POPUP "插件(&P)"
    BEGIN
        MENUITEM "打开插件目录…", IDM_SETTING_OPENPLUGINSDIR
    END
    POPUP "窗口(&W)"
    BEGIN
        MENUITEM "窗口列表…", IDM_WINDOW_WINDOWS
        MENUITEM SEPARATOR
        MENUITEM "Recent Window", IDM_WINDOW_MRU_FIRST, GRAYED
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "调试信息…", IDM_DEBUGINFO
        MENUITEM "关于（基于 Notepad++）", IDM_ABOUT
    END
    MENUITEM "＋", IDM_FILE_NEW, HELP
    POPUP "▼"
    BEGIN
        MENUITEM "Recent Window", IDM_DROPLIST_LIST, GRAYED
    END
    MENUITEM "✕", IDM_FILE_CLOSE, HELP
END
